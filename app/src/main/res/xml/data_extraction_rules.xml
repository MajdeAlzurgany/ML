<?xml version="1.0" encoding="utf-8"?>
<!-- The API key is encrypted with an Android Keystore key that never leaves the device,
     so nothing is backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
